<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="interfaz.FormLogin">
  <grid id="c0000" binding="Ventana" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="16" bottom="12" right="16"/>
    <constraints><xy x="20" y="20" width="460" height="324"/></constraints>
    <properties/><border type="none"/>
    <children>
      <component id="c0001" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="SISTEMA DE RECICLAJE Y RECOMPENSAS"/></properties>
      </component>
      <component id="c0002" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="Nombre de usuario:"/></properties>
      </component>
      <component id="c0003" class="javax.swing.JTextField" binding="txtUsuario">
        <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
          <preferred-size width="150" height="-1"/></grid></constraints>
        <properties/>
      </component>
      <component id="c0004" class="javax.swing.JLabel">
        <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="Contraseña:"/></properties>
      </component>
      <component id="c0005" class="javax.swing.JPasswordField" binding="txtClave">
        <constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
          <preferred-size width="150" height="-1"/></grid></constraints>
        <properties/>
      </component>
      <component id="c0006" class="javax.swing.JButton" binding="btnLogin" default-binding="true">
        <constraints><grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="Iniciar sesión"/></properties>
      </component>
      <component id="c0007" class="javax.swing.JButton" binding="btnRegistrarse" default-binding="true">
        <constraints><grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="Registrarse"/></properties>
      </component>
      <component id="c0008" class="javax.swing.JButton" binding="btnOlvide" default-binding="true">
        <constraints><grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties><text value="Olvidé mi contraseña"/></properties>
      </component>
    </children>
  </grid>
</form>
