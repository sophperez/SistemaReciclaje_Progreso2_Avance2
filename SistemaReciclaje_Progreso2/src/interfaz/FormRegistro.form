<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="interfaz.FormRegistro">
  <grid id="c0000" binding="Ventana" layout-manager="GridLayoutManager" row-count="10" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="16" bottom="12" right="16"/>
    <constraints><xy x="20" y="20" width="460" height="500"/></constraints>
    <properties/><border type="none"/>
    <children>
      <component id="c0009" class="javax.swing.JLabel">
